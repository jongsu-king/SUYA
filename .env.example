# Optional. Copy to ".env" in the folder you run the program from, or put the same lines in the
# per-user settings file the GUI writes (File > Settings):
#   macOS    ~/Library/Application Support/SUYA/settings.env
#   Windows  %APPDATA%\SUYA\settings.env
#   Linux    ~/.local/share/SUYA/settings.env
# Precedence: environment variable > .env in the current folder > settings.env
#
# 선택 사항입니다. 프로그램을 실행하는 폴더의 ".env"에 복사하거나, GUI(파일 > 설정)가 쓰는
# 사용자 설정 파일에 같은 줄을 넣으세요. 우선순위: 환경 변수 > 현재 폴더 .env > settings.env

# Interface language: ko or en. Unset = ask once, then remember.
# 화면 언어: ko 또는 en. 비우면 처음 한 번 묻고 기억합니다.
MONITOR_LANG=

# Windy Point Forecast API key (https://api.windy.com/keys). Everything else works without it.
# testing = free key: Windy returns shuffled, altered values and the GUI labels them as such.
# professional = paid key.
WINDY_API_KEY=
WINDY_KEY_TIER=testing
# Comma separated. Calls per run = (24 points) x (models).
WINDY_MODELS=gfs

# Where data goes. Defaults: the per-user folder above for the database,
# ~/Documents/SUYA for the Excel workbooks.
MONITOR_DB_PATH=
MONITOR_EXCEL_DIR=

# Collection intervals in seconds (defaults shown). Minimum 30.
# MONITOR_INTERVAL_METAR=300
# MONITOR_INTERVAL_OPENMETEO_CURRENT=900
# MONITOR_INTERVAL_OPENMETEO_MARINE=1800
# MONITOR_INTERVAL_OPENMETEO_FORECAST=10800
# MONITOR_INTERVAL_GFS_GRID=10800
# MONITOR_INTERVAL_OISST=21600
# MONITOR_INTERVAL_SMOS=21600
# MONITOR_INTERVAL_SMAP=21600
# MONITOR_INTERVAL_HYCOM_GRID=10800
# MONITOR_INTERVAL_HYCOM_PROFILES=86400
# MONITOR_INTERVAL_ARGO=3600
# MONITOR_INTERVAL_GOSUD=3600
# MONITOR_INTERVAL_OSMC=3600
# MONITOR_INTERVAL_WINDY=10800
# MONITOR_INTERVAL_EXCEL=900

# Self-imposed cap under Open-Meteo's free limit of 10,000 calls/day.
MONITOR_OPENMETEO_DAILY_BUDGET=9000
